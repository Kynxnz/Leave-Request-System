APP_NAME="Leave Request System"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Manila

LOG_CHANNEL=stack
LOG_LEVEL=debug

# SQLite: no database server needed (file is created by setup)
DB_CONNECTION=sqlite

SESSION_DRIVER=database
CACHE_STORE=file
QUEUE_CONNECTION=sync

# Emails are written to storage/logs/laravel.log
MAIL_MAILER=log
MAIL_FROM_ADDRESS="hr@leave-system.test"
MAIL_FROM_NAME="${APP_NAME}"
